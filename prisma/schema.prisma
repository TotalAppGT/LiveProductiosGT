generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DUENO
  ADMIN
  JEFE
  EMPLEADO
}

enum TaskType {
  FIJA
  DINAMICA
}

enum TaskFrequency {
  DIARIA
  SEMANAL
  MENSUAL
}

enum DayOfWeek {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

enum TaskStatus {
  PENDIENTE
  EN_PROCESO
  COMPLETADA
  REPROGRAMADA
  CANCELADA
}

enum TaskPriority {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum TaskCategory {
  PRE_EVENTO
  EVENTO
  POST_EVENTO
  COTIZACION
  COBRO
  INVENTARIO
  VEHICULO
  PERSONAL
  BODEGA
  MANTENIMIENTO
  ADMINISTRACION
  OTRO
}

enum EventStatus {
  COTIZACION
  CONFIRMADO
  EN_PROGRESO
  COMPLETADO
  CANCELADO
}

enum InventoryCategory {
  AUDIO
  ILUMINACION
  INSTRUMENTO
  CABLEADO
  MOBILIARIO
  HERRAMIENTA
  CONSUMIBLE
  OTRO
}

enum InventoryStatus {
  DISPONIBLE
  ASIGNADO
  EN_REPARACION
  PERDIDO
  DANADO
}

enum InventoryLocation {
  BODEGA_ELGIN
  BODEGA_PP
  EN_EVENTO
  EN_RENTA
}

enum VehicleStatus {
  DISPONIBLE
  EN_USO
  EN_MANTENIMIENTO
  FUERA_SERVICIO
}

enum VehicleType {
  CAMION
  PANEL
  PICKUP
  MOTO
  SEDAN
  OTRO
}

enum CobroStatus {
  PENDIENTE
  PARCIAL
  COMPLETADO
}

enum WhatsAppMessageType {
  TASK_REMINDER
  EVENT_REMINDER
  NOTIFICATION
  ALERT
  CHAT
  BIHOURLY_REMINDER
}

enum WhatsAppMessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  events   Event[]
  tasks    Task[]
  vehicles Vehicle[]
  cobros   Cobro[]
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  password        String
  name            String
  phone           String?
  role            Role     @default(EMPLEADO)
  firebaseUid     String?  @unique
  avatar          String?
  whatsappNumber  String?
  active          Boolean  @default(true)
  tenantId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant           Tenant?            @relation(fields: [tenantId], references: [id])
  assignedTasks    Task[]             @relation("TaskAssignee")
  createdTasks     Task[]             @relation("TaskCreator")
  taskComments     TaskComment[]
  taskHistory      TaskHistory[]
  inventoryItems   InventoryItem[]
  vehicles         Vehicle[]
  cobros           Cobro[]
  activities       Activity[]
  whatsappMessages WhatsAppMessage[]
  plannedEvents    Event[]            @relation("EventPlanner")
  responsibleEvents Event[]           @relation("EventResponsible")
  uploadedFiles    FileAttachment[]
  incomeRecords    IncomeRecord[]     @relation("IncomeRecorder")
  myIncome         IncomeRecord[]
  remindersCreated Reminder[]
  remindersAssigned Reminder[] @relation("ReminderAssignee")
  pushTokens        PushToken[]
  createdGroups     Group[]       @relation("GroupCreator")
  groupMemberships  GroupMember[]
  createdAlerts     ScheduledAlert[] @relation("AlertCreator")
  targetedAlerts    ScheduledAlert[] @relation("AlertTarget")
  maintenanceDone   VehicleMaintenance[]
  workshopAssigned  WorkshopItem[] @relation("WorkshopTechnician")
  workshopCreated   WorkshopItem[] @relation("WorkshopCreator")
}

model Task {
  id                 String       @id @default(cuid())
  title              String
  description        String?
  type               TaskType     @default(FIJA)
  frequency          TaskFrequency?
  dayOfWeek          DayOfWeek?
  dueDate            DateTime?
  status             TaskStatus   @default(PENDIENTE)
  priority           TaskPriority @default(MEDIA)
  category           TaskCategory @default(OTRO)
  comments           String?
  rescheduledTo      DateTime?
  requiresConfirmation Boolean   @default(false)
  confirmedAt        DateTime?
  assignedToId       String?
  assignedById       String?
  eventId            String?
  tenantId           String?
  postponeReason     String?
  postponeCount      Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  assignedTo User?          @relation("TaskAssignee", fields: [assignedToId], references: [id])
  assignedBy User?          @relation("TaskCreator", fields: [assignedById], references: [id])
  event      Event?         @relation(fields: [eventId], references: [id])
  tenant     Tenant?        @relation(fields: [tenantId], references: [id])
  commentsList      TaskComment[]
  history          TaskHistory[]
  whatsappMessages WhatsAppMessage[]
  attachments      FileAttachment[]
}

model TaskComment {
  id        String   @id @default(cuid())
  content   String
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}

model TaskHistory {
  id             String     @id @default(cuid())
  taskId         String
  userId         String
  action         String
  previousStatus TaskStatus?
  newStatus      TaskStatus?
  createdAt      DateTime   @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}

model Event {
  id            String      @id @default(cuid())
  name          String
  clientName    String
  clientPhone   String?
  clientEmail   String?
  date          DateTime
  location      String?
  guestCount    Int?
  status        EventStatus @default(COTIZACION)
  serviceType   String?
  audioType     String?
  plannerId     String?
  responsibleId String?
  notes         String?
  tenantId      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  planner     User?    @relation("EventPlanner", fields: [plannerId], references: [id])
  responsible User?    @relation("EventResponsible", fields: [responsibleId], references: [id])
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  tasks            Task[]
  cobros           Cobro[]
  whatsappMessages WhatsAppMessage[]
  attachments      FileAttachment[]
  incomeRecords    IncomeRecord[]
}

model InventoryItem {
  id            String           @id @default(cuid())
  name          String
  category      InventoryCategory @default(OTRO)
  quantity      Int              @default(1)
  assignedToId  String?
  status         InventoryStatus  @default(DISPONIBLE)
  location       String           @default("Bodega Elgin")
  notes         String?
  lastCheckedAt DateTime?
  serialNumber  String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  assignedTo User? @relation(fields: [assignedToId], references: [id])
  attachments FileAttachment[]
}

model Vehicle {
  id                String        @id @default(cuid())
  name              String
  plate             String        @unique
  type              VehicleType   @default(OTRO)
  status            VehicleStatus @default(DISPONIBLE)
  assignedToId      String?
  mileage           Int?
  fuelLevel         Int?
  lastMaintenanceAt DateTime?
  notes             String?
  tenantId          String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  assignedTo         User?                @relation(fields: [assignedToId], references: [id])
  tenant             Tenant?              @relation(fields: [tenantId], references: [id])
  maintenanceRecords VehicleMaintenance[]
}

model VehicleMaintenance {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type        String   @default("OTRO")
  description String?
  cost        Decimal? @db.Decimal(10, 2)
  date        DateTime @default(now())
  mileage     Int?
  doneById    String?
  doneBy      User?    @relation(fields: [doneById], references: [id])
  notes        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([vehicleId])
}

model WorkshopItem {
  id           String    @id @default(cuid())
  itemName     String
  category     String    @default("AUDIO")
  issue        String
  diagnostic   String?
  status       String    @default("EN_REVISION")
  assignedToId String?
  assignedTo   User?     @relation("WorkshopTechnician", fields: [assignedToId], references: [id])
  createdById  String
  createdBy    User      @relation("WorkshopCreator", fields: [createdById], references: [id])
  completedAt  DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
}

model Cobro {
  id            String     @id @default(cuid())
  clientName    String
  amount        Decimal    @db.Decimal(10, 2)
  status        CobroStatus @default(PENDIENTE)
  invoiceNumber String?
  dueDate       DateTime?
  assignedToId  String?
  notes         String?
  eventId       String?
  tenantId      String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  event      Event?  @relation(fields: [eventId], references: [id])
  assignedTo User?   @relation(fields: [assignedToId], references: [id])
  tenant     Tenant? @relation(fields: [tenantId], references: [id])
}

model Activity {
  id         String   @id @default(cuid())
  userId     String
  action     String
  resource   String?
  resourceId String?
  details    String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model AISettings {
  id           String   @id @default(uuid())
  provider     String   @default("DEEPSEEK")
  apiKey       String   @default("")
  model        String   @default("deepseek-chat")
  baseUrl      String   @default("https://api.deepseek.com/v1")
  temperature  Float    @default(0.7)
  maxTokens    Int      @default(2000)
  systemPrompt String   @default("Eres el asistente de Live Productions Guatemala...") @db.Text
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  description String   @default("")
  updatedAt   DateTime @updatedAt
}

model WhatsAppConfig {
  id            String   @id @default(uuid())
  phoneNumberId String   @default("")
  accessToken   String   @default("")
  verifyToken   String   @default("")
  businessPhone String   @default("")
  webhookUrl    String   @default("")
  qrCodeUrl     String   @default("")
  isActive      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WhatsAppMessage {
  id            String               @id @default(cuid())
  userId        String
  toNumber      String
  message       String
  type          WhatsAppMessageType  @default(NOTIFICATION)
  status        WhatsAppMessageStatus @default(SENT)
  relatedTaskId String?
  relatedEventId String?
  createdAt     DateTime             @default(now())

  user         User?  @relation(fields: [userId], references: [id])
  relatedTask  Task?  @relation(fields: [relatedTaskId], references: [id])
  relatedEvent Event? @relation(fields: [relatedEventId], references: [id])
}

model FileAttachment {
  id           String   @id @default(uuid())
  fileName     String
  fileUrl      String
  fileType     String
  fileSize     Int
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  taskId       String?
  task         Task?    @relation(fields: [taskId], references: [id])
  eventId      String?
  event        Event?   @relation(fields: [eventId], references: [id])
  inventoryId  String?
  inventory    InventoryItem? @relation(fields: [inventoryId], references: [id])
  createdAt    DateTime @default(now())
}

model Reminder {
  id           String   @id @default(uuid())
  title        String
  description  String?
  remindAt     DateTime
  isCompleted  Boolean  @default(false)
  completedAt  DateTime?
  createdById  String
  createdBy    User     @relation(fields: [createdById], references: [id])
assignedToId String
  assignedTo   User   @relation("ReminderAssignee", fields: [assignedToId], references: [id])
  notified     Boolean  @default(false)
  advanceNotified Boolean @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model IncomeRecord {
  id           String   @id @default(uuid())
  amount       Float
  description  String
  type         String   @default("COBRO")
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  eventId      String?
  event        Event?   @relation(fields: [eventId], references: [id])
  recordedById String
  recordedBy   User     @relation("IncomeRecorder", fields: [recordedById], references: [id])
  createdAt    DateTime @default(now())
}

model PushToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  platform  String   @default("expo")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Group {
  id          String   @id @default(uuid())
  name        String
  description String   @default("")
  createdById String
  createdBy   User     @relation("GroupCreator", fields: [createdById], references: [id])
  members     GroupMember[]
  alerts      ScheduledAlert[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GroupMember {
  id      String @id @default(uuid())
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model ScheduledAlert {
  id           String    @id @default(uuid())
  title        String
  message      String
  type         String    @default("PERSONALIZADA")
  scheduledAt  DateTime?
  frequency    String?
  dayOfWeek    String?
  time         String?
  groupId      String?
  group        Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  targetUserId String?
  targetUser   User?     @relation("AlertTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  createdById  String
  createdBy    User      @relation("AlertCreator", fields: [createdById], references: [id])
  isActive     Boolean   @default(true)
  lastSentAt   DateTime?
  sendCount    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
