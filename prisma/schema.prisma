generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DUENO
  ADMIN
  JEFE
  EMPLEADO
}

enum TaskType {
  FIJA
  DINAMICA
}

enum TaskFrequency {
  DIARIA
  SEMANAL
  MENSUAL
}

enum DayOfWeek {
  LUNES
  MARTES
  MIERCOLES
  JUEVES
  VIERNES
  SABADO
  DOMINGO
}

enum TaskStatus {
  PENDIENTE
  EN_PROCESO
  COMPLETADA
  REPROGRAMADA
  CANCELADA
}

enum TaskPriority {
  BAJA
  MEDIA
  ALTA
  URGENTE
}

enum TaskCategory {
  PRE_EVENTO
  EVENTO
  POST_EVENTO
  COTIZACION
  COBRO
  INVENTARIO
  VEHICULO
  PERSONAL
  BODEGA
  MANTENIMIENTO
  ADMINISTRACION
  OTRO
}

enum EventStatus {
  COTIZACION
  CONFIRMADO
  EN_PROGRESO
  COMPLETADO
  CANCELADO
}

enum InventoryCategory {
  AUDIO
  ILUMINACION
  INSTRUMENTO
  CABLEADO
  MOBILIARIO
  HERRAMIENTA
  CONSUMIBLE
  OTRO
}

enum InventoryStatus {
  DISPONIBLE
  ASIGNADO
  EN_REPARACION
  PERDIDO
  DANADO
}

enum InventoryLocation {
  BODEGA_ELGIN
  BODEGA_PP
  EN_EVENTO
  EN_RENTA
}

enum VehicleStatus {
  DISPONIBLE
  EN_USO
  EN_MANTENIMIENTO
  FUERA_SERVICIO
}

enum VehicleType {
  CAMION
  PANEL
  PICKUP
  MOTO
  SEDAN
  OTRO
}

enum CobroStatus {
  PENDIENTE
  PARCIAL
  COMPLETADO
}

enum WhatsAppMessageType {
  TASK_REMINDER
  EVENT_REMINDER
  NOTIFICATION
  ALERT
  CHAT
  BIHOURLY_REMINDER
}

enum WhatsAppMessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users    User[]
  events   Event[]
  tasks    Task[]
  vehicles Vehicle[]
  cobros   Cobro[]
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  password       String
  name           String
  phone          String?
  role           Role     @default(EMPLEADO)
  firebaseUid    String?  @unique
  avatar         String?
  whatsappNumber String?
  active          Boolean  @default(true)
  position        String   @default("")
  modules         String   @default("")
  tenantId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant            Tenant?              @relation(fields: [tenantId], references: [id])
  assignedTasks     Task[]               @relation("TaskAssignee")
  createdTasks      Task[]               @relation("TaskCreator")
  taskComments      TaskComment[]
  taskHistory       TaskHistory[]
  inventoryItems    InventoryItem[]
  vehicles          Vehicle[]
  cobros            Cobro[]
  activities        Activity[]
  whatsappMessages  WhatsAppMessage[]
  plannedEvents     Event[]              @relation("EventPlanner")
  responsibleEvents Event[]              @relation("EventResponsible")
  uploadedFiles     FileAttachment[]
  incomeRecords     IncomeRecord[]       @relation("IncomeRecorder")
  myIncome          IncomeRecord[]
  remindersCreated  Reminder[]
  remindersAssigned Reminder[]           @relation("ReminderAssignee")
  pushTokens        PushToken[]
  createdGroups     Group[]              @relation("GroupCreator")
  groupMemberships  GroupMember[]
  createdAlerts     ScheduledAlert[]     @relation("AlertCreator")
  targetedAlerts    ScheduledAlert[]     @relation("AlertTarget")
  maintenanceDone   VehicleMaintenance[]
  workshopAssigned  WorkshopItem[]       @relation("WorkshopTechnician")
  workshopCreated   WorkshopItem[]       @relation("WorkshopCreator")
  createdOrders     Order[]        @relation("OrderCreator")
  createdTemplates  OrderTemplate[] @relation("OrderTemplateCreator")
  vehicleLogs       VehicleLog[]   @relation("VehicleLogDriver")
  createdReports    Report[]       @relation("ReportCreator")
  personalNotes     PersonalNote[] @relation("PersonalNoteOwner")
  createdPurchases  Purchase[]     @relation("PurchaseCreator")
  assignedPurchases Purchase[]     @relation("PurchaseAssignee")
}

model Task {
  id                   String         @id @default(cuid())
  title                String
  description          String?
  type                 TaskType       @default(FIJA)
  frequency            TaskFrequency?
  dayOfWeek            DayOfWeek?
  dueDate              DateTime?
  status               TaskStatus     @default(PENDIENTE)
  priority             TaskPriority   @default(MEDIA)
  category             TaskCategory   @default(OTRO)
  comments             String?
  rescheduledTo        DateTime?
  requiresConfirmation Boolean        @default(false)
  confirmedAt          DateTime?
  asReminder           Boolean        @default(false)
  reminderSentAt       DateTime?
  assignedToId         String?
  assignedById         String?
  eventId              String?
  tenantId             String?
  postponeReason       String?
  postponeCount        Int            @default(0)
  sortOrder            Int            @default(0)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  assignedTo       User?             @relation("TaskAssignee", fields: [assignedToId], references: [id])
  assignedBy       User?             @relation("TaskCreator", fields: [assignedById], references: [id])
  event            Event?            @relation(fields: [eventId], references: [id])
  tenant           Tenant?           @relation(fields: [tenantId], references: [id])
  commentsList     TaskComment[]
  history          TaskHistory[]
  whatsappMessages WhatsAppMessage[]
  attachments      FileAttachment[]
}

model TaskComment {
  id        String   @id @default(cuid())
  content   String
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}

model TaskHistory {
  id             String      @id @default(cuid())
  taskId         String
  userId         String
  action         String
  previousStatus TaskStatus?
  newStatus      TaskStatus?
  createdAt      DateTime    @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
}

model Event {
  id            String      @id @default(cuid())
  name          String
  clientName    String
  clientPhone   String?
  clientEmail   String?
  date          DateTime
  location      String?
  guestCount    Int?
  status        EventStatus @default(COTIZACION)
  serviceType   String?
  audioType     String?
  plannerId     String?
  responsibleId String?
  notes         String?
  tenantId      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  planner          User?             @relation("EventPlanner", fields: [plannerId], references: [id])
  responsible      User?             @relation("EventResponsible", fields: [responsibleId], references: [id])
  tenant           Tenant?           @relation(fields: [tenantId], references: [id])
  tasks            Task[]
  cobros           Cobro[]
  whatsappMessages WhatsAppMessage[]
  attachments      FileAttachment[]
  incomeRecords    IncomeRecord[]
}

model InventoryItem {
  id            String            @id @default(cuid())
  name          String
  category      InventoryCategory @default(OTRO)
  quantity      Int               @default(1)
  assignedToId  String?
  status        InventoryStatus   @default(DISPONIBLE)
  location      String            @default("Bodega Elgin")
  notes         String?
  lastCheckedAt DateTime?
  serialNumber  String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  assignedTo  User?            @relation(fields: [assignedToId], references: [id])
  attachments FileAttachment[]
}

model Vehicle {
  id                String        @id @default(cuid())
  name              String
  plate             String        @unique
  type              VehicleType   @default(OTRO)
  status            VehicleStatus @default(DISPONIBLE)
  assignedToId      String?
  mileage           Int?
  fuelLevel         Int?
  lastMaintenanceAt DateTime?
  notes             String?
  tenantId          String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  assignedTo         User?                @relation(fields: [assignedToId], references: [id])
  tenant             Tenant?              @relation(fields: [tenantId], references: [id])
  maintenanceRecords VehicleMaintenance[]
  vehicleLogs        VehicleLog[]
}

model VehicleMaintenance {
  id          String   @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type        String   @default("OTRO")
  description String?
  cost        Decimal? @db.Decimal(10, 2)
  date        DateTime @default(now())
  mileage     Int?
  doneById    String?
  doneBy      User?    @relation(fields: [doneById], references: [id])
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([vehicleId])
}

model WorkshopItem {
  id           String    @id @default(cuid())
  itemName     String
  category     String    @default("AUDIO")
  issue        String
  diagnostic   String?
  status       String    @default("EN_REVISION")
  assignedToId String?
  assignedTo   User?     @relation("WorkshopTechnician", fields: [assignedToId], references: [id])
  createdById  String
  createdBy    User      @relation("WorkshopCreator", fields: [createdById], references: [id])
  completedAt  DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
}

model Cobro {
  id            String      @id @default(cuid())
  clientName    String
  amount        Decimal     @db.Decimal(10, 2)
  status        CobroStatus @default(PENDIENTE)
  invoiceNumber String?
  dueDate       DateTime?
  assignedToId  String?
  notes         String?
  eventId       String?
  tenantId      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  event      Event?  @relation(fields: [eventId], references: [id])
  assignedTo User?   @relation(fields: [assignedToId], references: [id])
  tenant     Tenant? @relation(fields: [tenantId], references: [id])
}

model Activity {
  id         String   @id @default(cuid())
  userId     String
  action     String
  resource   String?
  resourceId String?
  details    String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model AISettings {
  id           String   @id @default(uuid())
  provider     String   @default("DEEPSEEK")
  apiKey       String   @default("")
  model        String   @default("deepseek-chat")
  baseUrl      String   @default("https://api.deepseek.com/v1")
  temperature  Float    @default(0.7)
  maxTokens    Int      @default(2000)
  systemPrompt String   @default("Eres el asistente de Live Productions Guatemala...") @db.Text
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SystemConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String   @db.Text
  description String   @default("")
  updatedAt   DateTime @updatedAt
}

model WhatsAppConfig {
  id            String   @id @default(uuid())
  phoneNumberId String   @default("")
  accessToken   String   @default("")
  verifyToken   String   @default("")
  businessPhone String   @default("")
  webhookUrl    String   @default("")
  qrCodeUrl     String   @default("")
  isActive      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WhatsAppMessage {
  id             String                @id @default(cuid())
  userId         String
  toNumber       String
  message        String
  type           WhatsAppMessageType   @default(NOTIFICATION)
  status         WhatsAppMessageStatus @default(SENT)
  relatedTaskId  String?
  relatedEventId String?
  createdAt      DateTime              @default(now())

  user         User?  @relation(fields: [userId], references: [id])
  relatedTask  Task?  @relation(fields: [relatedTaskId], references: [id])
  relatedEvent Event? @relation(fields: [relatedEventId], references: [id])
}

model Order {
  id          String      @id @default(cuid())
  orderNumber Int
  eventName   String
  status      String      @default("BORRADOR")
  templateId  String?
  createdById String
  createdBy   User        @relation("OrderCreator", fields: [createdById], references: [id])
  items       OrderItem[]
  sentAt      DateTime?
  returnedAt  DateTime?
  readyById   String?
  returnById  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([orderNumber])
}

model OrderItem {
  id              String    @id @default(cuid())
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name            String
  category        String    @default("AUDIO")
  quantity        Int       @default(1)
  preparedPhotos  String[]  @default([])
  preparedChecked Boolean   @default(false)
  preparedById    String?
  preparedAt      DateTime?
  returnPhotos    String[]  @default([])
  returnChecked   Boolean   @default(false)
  returnedById    String?
  returnedAt      DateTime?
  returnCondition String?
  inventoryItemId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([orderId])
}

model OrderTemplate {
  id          String   @id @default(cuid())
  name        String
  items       Json
  createdById String
  createdBy   User     @relation("OrderTemplateCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
}

model VehicleLog {
  id           String    @id @default(cuid())
  vehicleId    String?
  vehicle      Vehicle?  @relation(fields: [vehicleId], references: [id])
  plate        String
  vehicleType  String
  driverId     String
  driver       User      @relation("VehicleLogDriver", fields: [driverId], references: [id])
  status       String    @default("EN_USO")
  startKm      Int
  startWater   String    @default("")
  startOil     String    @default("")
  startPhotos  String[]  @default([])
  startAt      DateTime  @default(now())
  startComment String?
  endKm        Int?
  endWater     String?
  endOil       String?
  endPhotos    String[]  @default([])
  endAt        DateTime?
  endComment   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  fuelEntries VehicleLogFuel[]
}

model VehicleLogFuel {
  id        String     @id @default(cuid())
  logId     String
  log       VehicleLog @relation(fields: [logId], references: [id], onDelete: Cascade)
  kmBefore  Int?
  kmAfter   Int?
  amount    String?
  photos    String[]   @default([])
  createdAt DateTime   @default(now())

  @@index([logId])
}

model Report {
  id           String   @id @default(cuid())
  title        String
  category     String   @default("OTROS")
  resourceType String   @default("")
  resourceId   String   @default("")
  pdfData      String?  @db.Text
  createdById  String
  createdBy    User     @relation("ReportCreator", fields: [createdById], references: [id])
  createdAt    DateTime @default(now())

  @@index([category])
}

model PersonalNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("PersonalNoteOwner", fields: [userId], references: [id])
  title     String   @default("")
  content   String
  type      String   @default("NOTA")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Purchase {
  id           String    @id @default(cuid())
  title        String
  description  String?
  amount       Decimal?  @db.Decimal(10, 2)
  advance      Decimal?  @db.Decimal(10, 2)
  provider     String?
  status       String    @default("PENDIENTE") // PENDIENTE | COMPRADO | CANCELADO
  dueDate      DateTime?
  priority     String    @default("MEDIA") // BAJA | MEDIA | ALTA | URGENTE
  assignedToId String?
  assignedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  assignedTo User? @relation("PurchaseAssignee", fields: [assignedToId], references: [id])
  assignedBy User? @relation("PurchaseCreator", fields: [assignedById], references: [id])

  @@index([status])
  @@index([assignedToId])
}

model ScheduledMessage {
  id          String    @id @default(cuid())
  toNumber    String
  message     String
  scheduledAt DateTime
  status      String    @default("PENDIENTE") // PENDIENTE | ENVIADO | CANCELADO
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([scheduledAt])
}

model FileAttachment {
  id           String         @id @default(uuid())
  fileName     String
  fileUrl      String
  fileType     String
  fileSize     Int
  uploadedById String
  uploadedBy   User           @relation(fields: [uploadedById], references: [id])
  taskId       String?
  task         Task?          @relation(fields: [taskId], references: [id])
  eventId      String?
  event        Event?         @relation(fields: [eventId], references: [id])
  inventoryId  String?
  inventory    InventoryItem? @relation(fields: [inventoryId], references: [id])
  createdAt    DateTime       @default(now())
}

model Reminder {
  id              String    @id @default(uuid())
  title           String
  description     String?
  remindAt        DateTime
  isCompleted     Boolean   @default(false)
  completedAt     DateTime?
  createdById     String
  createdBy       User      @relation(fields: [createdById], references: [id])
  assignedToId    String
  assignedTo      User      @relation("ReminderAssignee", fields: [assignedToId], references: [id])
  notified        Boolean   @default(false)
  advanceNotified Boolean   @default(false)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model IncomeRecord {
  id           String   @id @default(uuid())
  amount       Float
  description  String
  type         String   @default("COBRO")
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  eventId      String?
  event        Event?   @relation(fields: [eventId], references: [id])
  recordedById String
  recordedBy   User     @relation("IncomeRecorder", fields: [recordedById], references: [id])
  createdAt    DateTime @default(now())
}

model PushToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  platform  String   @default("expo")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Group {
  id          String           @id @default(uuid())
  name        String
  description String           @default("")
  createdById String
  createdBy   User             @relation("GroupCreator", fields: [createdById], references: [id])
  members     GroupMember[]
  alerts      ScheduledAlert[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model GroupMember {
  id      String @id @default(uuid())
  groupId String
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model ScheduledAlert {
  id           String    @id @default(uuid())
  title        String
  message      String
  type         String    @default("PERSONALIZADA")
  scheduledAt  DateTime?
  frequency    String?
  dayOfWeek    String?
  time         String?
  groupId      String?
  group        Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  targetUserId String?
  targetUser   User?     @relation("AlertTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  createdById  String
  createdBy    User      @relation("AlertCreator", fields: [createdById], references: [id])
  isActive     Boolean   @default(true)
  lastSentAt   DateTime?
  sendCount    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
